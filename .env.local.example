# ───────── Sanity (Project ID y dataset) ─────────
# Estos cuatro pares duplican el mismo valor con prefijos distintos:
# - NEXT_PUBLIC_* lo usa el sitio Next (las páginas que leen contenido)
# - SANITY_STUDIO_* lo usa el Studio (panel admin) corriendo bajo Vite
# El Project ID es público, no es secreto. Lo encontrás en sanity.io/manage > Settings > API.
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_STUDIO_PROJECT_ID=

NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_DATASET=production

# ───────── Sanity (secretos del servidor) ─────────
# Token con rol Editor — usado solo del lado del server (NUNCA NEXT_PUBLIC_).
SANITY_API_TOKEN=

# Secret del webhook de revalidación. Generá uno con: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
