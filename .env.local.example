# ───────── Sanity (CMS) ─────────
# Project ID — lo encontrás en sanity.io/manage > tu proyecto > Settings > API
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset — por defecto "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Token Editor — necesario para el webhook (genera uno en Sanity > Settings > API > Tokens)
SANITY_API_TOKEN=

# Secret del webhook de revalidación — lo configurás también en Sanity > Settings > API > Webhooks
SANITY_REVALIDATE_SECRET=
