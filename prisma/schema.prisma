// Prisma schema — LandingCETIP admin builder (spec 002)
// Modelo de contenido: páginas como listas ordenadas de secciones tipadas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------- Contenido --------

model Page {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  seoTitle        String?
  seoDescription  String?
  published       Boolean   @default(true)
  sections        Section[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model SiteSettings {
  id              Int    @id @default(1)
  name            String
  fullName        String
  tagline         String
  description     String
  address         String
  phoneDisplay    String
  phoneTel        String
  whatsappNumber  String
  whatsappMessage String
  email           String
  hours           String
  socials         Json
  mapsEmbed       String
  headerConfig    Json?
  footerConfig    Json?
}

// -------- Colecciones --------

model Professional {
  id           String       @id @default(cuid())
  nombre       String
  rol          String
  disciplina   String
  descripcion  String?
  fotoAssetId  String?
  fotoAsset    MediaAsset?  @relation("ProfessionalPhoto", fields: [fotoAssetId], references: [id])
  orden        Int          @default(0)
  visible      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Workshop {
  id            String   @id @default(cuid())
  titulo        String
  dia           String
  horario       String
  destinatarios String
  descripcion   String
  visible       Boolean  @default(true)
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobOpening {
  id          String   @id @default(cuid())
  titulo      String
  area        String
  modalidad   String
  jornada     String
  descripcion String
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------- Media --------

model MediaAsset {
  id            String         @id @default(cuid())
  url           String
  pathname      String
  width         Int?
  height        Int?
  size          Int
  mime          String
  alt           String?
  uploadedBy    String?
  uploader      User?          @relation(fields: [uploadedBy], references: [id])
  professionals Professional[] @relation("ProfessionalPhoto")
  createdAt     DateTime       @default(now())
}

// -------- Auth (Auth.js v5 / @auth/prisma-adapter) --------

// Auth allowlist. Only admins exist — a Google login is accepted iff a User
// row exists for the lowercased email AND active === true. Deleting a row or
// flipping `active` to false revokes access on the next request.
// New rows default to active=false so a Google account auto-created by the
// adapter cannot self-provision as admin: someone with DB access must flip
// active=true explicitly.
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  active        Boolean      @default(false)
  lastLoginAt   DateTime?
  accounts      Account[]
  sessions      Session[]
  uploads       MediaAsset[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------- Buzón (form submissions) --------

model Submission {
  id          String   @id @default(cuid())
  kind        String   // "contacto" | "admision" | "rrhh" | otro
  pageSlug    String?
  name        String?
  email       String?
  phone       String?
  subject     String?
  message     String?  @db.Text
  attachments Json?    // arreglo de {url, filename, size, mime}
  meta        Json?    // ip, ua, extras
  read        Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([read, archived])
}
